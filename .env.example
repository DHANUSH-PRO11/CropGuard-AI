# AgroNex Root Environment Variables Template
# Copy to .env (or backend/.env) and populate with your credentials.

# 1. Gnani AI (Voice models: Prisma v3.0 STT & Timbre v3.0 TTS for Great Indian AI Challenge)
GNANI_API_KEY=your_gnani_api_key_here

# 2. Sarvam AI (Conversational agricultural LLM & Voice fallback)
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Supabase Cloud Database & Storage (Optional, runs in local fallback if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# 3. Networking & Deployment
FRONTEND_URL=http://localhost:5173
ALLOW_ALL_ORIGINS=false
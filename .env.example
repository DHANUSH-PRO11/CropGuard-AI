# AgroNex Root Environment Variables Template
# Copy to .env (or backend/.env) and populate with your credentials.

# 1. Sarvam AI (Conversational agricultural LLM, Tamil/English STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. Supabase Cloud Database & Storage (Optional, runs in local fallback if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# 3. Google OAuth 2.0 (Optional for farmer profile verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# 4. Networking & Deployment
FRONTEND_URL=http://localhost:5173
ALLOW_ALL_ORIGINS=false
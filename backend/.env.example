# AgroNex Backend Environment Variables Template
# Copy to backend/.env

# Sarvam AI API Key (Required for voice speech-to-text, LLM, and TTS synthesis)
SARVAM_API_KEY=your_sarvam_api_key_here

# Supabase Credentials (Optional for cloud storage of crop leaf images and history)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# Google OAuth 2.0 Client ID for backend token verification
GOOGLE_CLIENT_ID=your_google_client_id_here

# Web CORS settings
FRONTEND_URL=http://localhost:5173
ALLOW_ALL_ORIGINS=false

# AgroNex Backend Environment Variables Template
# Copy to backend/.env

# Gnani AI API Key (Prisma v3.0 STT & Timbre v3.0 TTS for Great Indian AI Challenge)
GNANI_API_KEY=your_gnani_api_key_here

# Sarvam AI API Key (Optional fallback)
SARVAM_API_KEY=your_sarvam_api_key_here

# Supabase Credentials (Optional for cloud storage of crop leaf images and history)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# Web CORS settings
FRONTEND_URL=http://localhost:5173
ALLOW_ALL_ORIGINS=false
